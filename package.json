{
  "name": "manzil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:firebase": "firebase emulators:exec --project demo-manzil --only auth,firestore \"tsx scripts/emulator-dev.ts\"",
    "dev:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/with-local-runtime.ps1 run dev:firebase",
    "test:firebase": "npm run build:server && firebase emulators:exec --config firebase.test.json --project demo-manzil-test --only auth,firestore \"vitest run tests/firebase-integration.test.ts\"",
    "build:cloud": "tsc --noEmit && vite build --mode cloud && node scripts/build-server.mjs",
    "build:server": "node scripts/build-server.mjs",
    "config:check": "tsx scripts/check-environment.ts",
    "auth:admin": "tsx scripts/set-admin.ts",
    "start:cloud": "node build/server/index.js",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "start": "tsx server/index.ts",
    "data:import": "tsx scripts/import-osm.ts",
    "art:entry-preview": "tsx scripts/generate-entry-preview.ts",
    "source:check": "tsx scripts/check-source.ts"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^7.2.0",
    "@turf/boolean-intersects": "^7.2.0",
    "@turf/buffer": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.14.0",
    "playwright-core": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "overrides": { "@grpc/grpc-js": "^1.14.0" },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.34.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.4"
  }
}
