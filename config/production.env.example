# Runtime configuration for a future Cloud Run API service. These are placeholders.
# Do not copy local .env into the container, and do not configure emulator hosts.
# Deployment region: asia-southeast1 (Singapore), matching the owner's Firestore location.
# Region is selected in Cloud Run deployment commands, not as a runtime variable.
NODE_ENV=production
MANZIL_MODE=production
MANZIL_SERVICE_ROLE=api
HOST=0.0.0.0
PORT=8080
FIREBASE_PROJECT_ID=YOUR_REAL_PROJECT_ID
ALLOWED_HOSTS=YOUR_API_HOST.run.app,YOUR_PROJECT.web.app,YOUR_PROJECT.firebaseapp.com
ALLOWED_ORIGINS=https://YOUR_PROJECT.web.app,https://YOUR_PROJECT.firebaseapp.com
# Required for Hosting pinTag rewrites: the confirmed hash-based service hostname,
# also included verbatim in ALLOWED_HOSTS. Accepts fh-* tags only for that service.
# FIREBASE_HOSTING_SERVICE_HOST=YOUR_SERVICE-HASH-REGION.a.run.app
TTS_ENABLED=false
PUBLIC_CLOUD_SPEECH=false
TTS_MONTHLY_CHARACTER_LIMIT=100000
TTS_ENGLISH_VOICE=en-GB-Wavenet-A
TTS_URDU_VOICE=ur-IN-Wavenet-A
X_SCRAPER_ENABLED=false
# Pakistan-wide providers. Select suitable hosted/self-hosted capacity before deployment;
# the public defaults are development demos with no availability guarantee.
# OSRM_BASE_URL=https://YOUR_OSRM_SERVICE
# PHOTON_BASE_URL=https://YOUR_PHOTON_SERVICE
# A separate worker deployment of the same image additionally needs:
# MANZIL_SERVICE_ROLE=worker
# WORKER_AUDIENCE=https://YOUR_WORKER_SERVICE.run.app
# WORKER_SERVICE_ACCOUNT_EMAIL=YOUR_SCHEDULER_IDENTITY@YOUR_PROJECT.iam.gserviceaccount.com
# WORKER_ALLOWED_JOBS=source
# SOURCE_MEDIA_BUCKET=YOUR_PRIVATE_SOURCE_IMAGE_BUCKET
# Optional Gemini worker activation: see docs/GEMINI_INTEGRATION.md.
# WORKER_ALLOWED_JOBS=source,agent
# GEMINI_ENABLED=true
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_AUTO_PUBLISH=false
# GEMINI_DAILY_REQUEST_LIMIT=20
# GEMINI_DAILY_BUDGET_USD=1
# Inject GEMINI_API_KEY from Secret Manager on the private worker only.
# Public API: SOURCE_MEDIA_READ_BUCKET=YOUR_PRIVATE_SOURCE_IMAGE_BUCKET
# Grant that API identity objectViewer on this bucket for admin image previews.
# Optional admin Run Gemini now (production API only, exact private Cloud Run origin):
# AGENT_WORKER_URL=https://YOUR_WORKER_ID.a.run.app
# Worker: additionally allow this project's API runtime service account for agent jobs only.
# WORKER_MANUAL_SERVICE_ACCOUNT_EMAIL=YOUR_API_IDENTITY@YOUR_PROJECT.iam.gserviceaccount.com
# Grant API identity roles/run.invoker on that worker service only. No model key on API.
