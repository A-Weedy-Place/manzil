# Runtime configuration for a future Cloud Run API service. These are placeholders.
# Do not copy local .env into the container, and do not configure emulator hosts.
# Deployment region: asia-southeast1 (Singapore), matching the owner's Firestore location.
# Region is selected in Cloud Run deployment commands, not as a runtime variable.
NODE_ENV=production
MANZIL_MODE=production
MANZIL_SERVICE_ROLE=api
HOST=0.0.0.0
PORT=8080
FIREBASE_PROJECT_ID=YOUR_REAL_PROJECT_ID
ALLOWED_HOSTS=YOUR_API_HOST.run.app,YOUR_PROJECT.web.app,YOUR_PROJECT.firebaseapp.com
ALLOWED_ORIGINS=https://YOUR_PROJECT.web.app,https://YOUR_PROJECT.firebaseapp.com
# Required for Hosting pinTag rewrites: the confirmed hash-based service hostname,
# also included verbatim in ALLOWED_HOSTS. Accepts fh-* tags only for that service.
# FIREBASE_HOSTING_SERVICE_HOST=YOUR_SERVICE-HASH-REGION.a.run.app
TTS_ENABLED=false
PUBLIC_CLOUD_SPEECH=false
TTS_MONTHLY_CHARACTER_LIMIT=100000
X_SCRAPER_ENABLED=false
# A separate worker deployment of the same image additionally needs:
# MANZIL_SERVICE_ROLE=worker
# WORKER_AUDIENCE=https://YOUR_WORKER_SERVICE.run.app
# WORKER_SERVICE_ACCOUNT_EMAIL=YOUR_SCHEDULER_IDENTITY@YOUR_PROJECT.iam.gserviceaccount.com
