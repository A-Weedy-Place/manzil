# Copy to ignored .env.cloud.local, fill with your registered Firebase web app values.
# These web identifiers are public configuration, not service-account secrets.
VITE_AUTH_MODE=firebase
VITE_FIREBASE_PROJECT_ID=YOUR_REAL_PROJECT_ID
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
