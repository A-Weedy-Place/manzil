# Standalone local development. npm run dev:firebase uses isolated emulators instead.
MANZIL_MODE=local
PORT=3001
HOST=127.0.0.1
MANZIL_DATA_DIR=./data
# The 2D map uses OpenFreeMap vector tiles with no API key.
# Theme and clean/detailed styling are changed in Profile.
# Public, accountless collector. Does not bypass login walls or access restrictions.
X_SCRAPER_ENABLED=true
# The collector targets the verified Champ profile every five minutes.
# Public HTML is read over bounded HTTPS; no browser executable or login is needed.

# Server-side Cloud Text-to-Speech. Disabled until billing/API/ADC are configured.
# Local: gcloud auth application-default login
# Cloud Run later: use an attached service identity, never a browser credential.
TTS_ENABLED=false
TTS_ENGLISH_VOICE=en-GB-Wavenet-A
TTS_URDU_VOICE=ur-IN-Wavenet-A
# Conservative per-calendar-month application cap (one SQLite-backed instance).
TTS_MONTHLY_CHARACTER_LIMIT=100000
# Cloud mode configuration templates: config/production.env.example and config/frontend.env.example.
# VITE_* values are public frontend build configuration; never place credentials there.

# Pakistan-wide online adapters; Islamabad trips still use the bundled local graph.
# Public demo instances are for light prototype use, without an availability guarantee.
# Replace with compatible hosted/self-hosted endpoints before larger-scale operation.
OSRM_BASE_URL=https://router.project-osrm.org
PHOTON_BASE_URL=https://photon.komoot.io

# Optional server-only Gemini Developer API. Never use a VITE_ key.
# Keep GEMINI_API_KEY in ignored .env.gemini.local, loaded only for local/emulator runs.
# Defaults remain off; agent:probe makes one deliberate model attempt without DB writes.
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_AUTO_PUBLISH=false
GEMINI_DAILY_REQUEST_LIMIT=20
GEMINI_DAILY_BUDGET_USD=1
