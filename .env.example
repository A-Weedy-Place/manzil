# Local single-user development. Never expose this unauthenticated prototype to a network.
PORT=3001
HOST=127.0.0.1
MANZIL_DATA_DIR=./data
# The 2D map uses OpenFreeMap vector tiles with no API key.
# Theme and clean/detailed styling are changed in Profile.
# Public, accountless collector. Does not bypass login walls or access restrictions.
X_SCRAPER_ENABLED=true
# The initial collector deliberately targets the verified Champ profile every 15 minutes.
# Optional installed Chrome/Edge executable; auto-detection tries standard Windows paths.
BROWSER_EXECUTABLE_PATH=
